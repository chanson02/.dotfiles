// -*- mode: jsonc -*-
{
    "spacing": 4, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "custom/mediaplayer/start",
        "hyprland/workspaces",
    ],
    // "modules-center": [
    //     "hyprland/window"
    // ],
    "modules-right": [
        "custom/updates",
        "pulseaudio",
        "image",
        "custom/mediaplayer",
        "clock",
        "tray"
    ],
    "hyprland/workspaces": {
        // "disable-scroll": true,
        "all-outputs": true,
        // "warp-on-scroll": false,
        "format": "{name}: {icon}",
        "format-icons": {
            "urgent": "",
            "active": "",
            "default": ""
        }
    },
    "tray": {
        "icon-size": 21,
        "spacing": 10
    },
    "clock": {
        "format": "{:%H:%M %m/%d/%Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        // "format": "{volume}% {icon} {format_source}",
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        // "on-click": "pavucontrol"
    },
    "image": {
      "path": "/tmp/waybar-mediaplayer-art",
      "size": 32,
      "signal": 4,
      "on-click": "feh --auto-zoom --borderless --title 'feh-float' /tmp/waybar-mediaplayer-art"
    },
    "custom/mediaplayer": {
      "exec": "cat /tmp/waybar-mediaplayer.json",
      "interval": 1,
      "return-type": "json",
      "format": "{}",
      "min-length": 20,
      "max-length": 20
    },
    "custom/mediaplayer/start": {
      "format": "",
      "hide_on_empty": true,
      "exec": "$HOME/.config/waybar/waybar-mediaplayer/src/mediaplayer monitor",
      "interval": "once"
    },
    "custom/updates": {
      "exec": "bash $HOME/.config/waybar/waybar-dnf-updates/checkupdates", // <--- path to script
      "on-click-right": "bash $HOME/.config/waybar/waybar-dnf-updates/checkupdates", // refresh on right click
      "on-click": "kitty sudo dnf update && bash $HOME/.config/waybar/waybar-dnf-updates/checkupdates",
      "interval": 10900,
      "return-type": "json",
      "format": "{icon} {}",
      "format-icons": {
          "has-updates": "", // icon when updates needed
          "updated": "" // icon when all packages updated
      }
    },
    "custom/power": {
      "format" : "⏻ ",
      "tooltip": false,
      "menu": "on-click",
      "menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
      "menu-actions": {
        "shutdown": "shutdown",
        "reboot": "reboot",
        "suspend": "systemctl suspend",
        "hibernate": "systemctl hibernate"
      }
    }
}
/* icons
     
*/
