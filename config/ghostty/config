config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

# font-family = MesloLGL Nerd Font
# font-size = 14
# font-thicken = true
#
# background-opacity = 0.7
# background-blur = false
# # ^ handled by hyprland
#
# # Pure rice
# window-padding-x = 20
# window-padding-y = 20
