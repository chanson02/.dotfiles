{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "echo": "allow",
    "grep": "allow",
    "glob": "allow",
    "bash": {
      "find *": "allow",
      "ls *": "allow",
      "grep *": "allow",
      "read *": "allow",
      "readlink *": "allow",
      "cat *": "allow",
      "wc *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "sort *": "allow",
      "xargs *": "allow",
      "sleep *": "allow",
      "tree *": "allow",
      "true *": "allow",
      "uniq *": "allow",

      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git commit *": "deny",
      "git push *": "deny",
      "git merge *": "ask",
      "git pull *": "ask",

      "docker ps *": "allow",
      "docker-compose logs *": "allow",
    },
    "external_directory": {
      "/tmp/**": "allow",
      "*": "ask"
    },
  },
  "plugin": [
    "opencode-kiro"
  ]
}
